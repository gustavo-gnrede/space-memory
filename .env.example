# Space Memory — environment configuration
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# The server auto-loads `.env` from the current working directory on startup.

# ---------------------------------------------------------------------------
# REQUIRED — hashing salt for every agent credential.
# Long, stable, random secret. Changing it invalidates ALL stored credential
# hashes, so generate once and keep it in your secret store.
#   e.g. `openssl rand -hex 32`
# ---------------------------------------------------------------------------
SPACE_MEMORY_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Storage — relational database URL (SQLAlchemy).
# SQLite (default) or PostgreSQL. The parent directory is created automatically.
# ---------------------------------------------------------------------------
SPACE_MEMORY_DATABASE_URL=sqlite:///./data/space-memory.db
# SPACE_MEMORY_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/space_memory

# ---------------------------------------------------------------------------
# Bootstrap credential — a single bearer token provisioned at first startup.
# Optional. Used to create your first Space and agent identity so you can make
# API calls before the admin onboarding flow ships.
# ---------------------------------------------------------------------------
SPACE_MEMORY_BOOTSTRAP_TOKEN=spm_local_replace_me
SPACE_MEMORY_SPACE_ID=default
SPACE_MEMORY_AGENT_ID=bootstrap-agent

# ---------------------------------------------------------------------------
# Bootstrap credentials (multi-agent) — JSON map of token -> {agent_id, space_id}.
# Prefer this over the single SPACE_MEMORY_BOOTSTRAP_TOKEN when wiring several
# agents. Merged with the single token above.
#   e.g. SPACE_MEMORY_BOOTSTRAP_TOKENS='{"spm_opencode":{"agent_id":"opencode"},"spm_claude":{"agent_id":"claude"}}'
# ---------------------------------------------------------------------------
SPACE_MEMORY_BOOTSTRAP_TOKENS=

# ---------------------------------------------------------------------------
# Vault encryption key — 32 bytes (64 hex chars), AES-256-GCM. Encrypts every
# secret stored via /api/v1/vault/* and the vault_* MCP tools. When unset, the
# vault endpoints return 503 (vault disabled). Generate once: `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
SPACE_MEMORY_VAULT_KEY=

# ---------------------------------------------------------------------------
# Rate limiting — per-credential (or per-IP for anonymous requests) sliding
# window. Requests per minute. Set to 0 to disable.
# ---------------------------------------------------------------------------
SPACE_MEMORY_RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------------------
# CLI lifecycle (space-memory start) defaults. Host/port can also be passed as
# --host / --port flags.
# ---------------------------------------------------------------------------
SPACE_MEMORY_HOST=127.0.0.1
SPACE_MEMORY_PORT=8787
SPACE_MEMORY_PIDFILE=data/space-memory.pid
SPACE_MEMORY_LOGFILE=data/space-memory.log
